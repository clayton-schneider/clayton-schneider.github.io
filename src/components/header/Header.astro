---
const links = [
	{ linkText: 'home', link: '/' }
	// { linkText: 'brag', link: '/brag' }
]

interface Props {
	className?: string
}
const { className } = Astro.props
---

<header class={(className ? className : '') + ' bg-primary flex flex-col items-center py-4 '}>
	<div class="mx-auto flex max-w-screen-xl flex-col items-center justify-between gap-3">
		<h1 class="text-2xl">clayton schneider</h1>

		<div>
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.link}>{link.linkText}</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</header>
