---
import { getCollection } from 'astro:content'
import CoreLayout from '~/layouts/CoreLayout.astro'
import ProjectCard from '~/components/ProjectCard.astro'
// import BlogList from '~/components/BlogList.astro'

const projects = await getCollection('projects')
---

<CoreLayout
	seo={{
		title: 'Clayton Schneider',
		description:
			'My name is Clayton Schneider and this website serves as my centralized space to show off and share everything that I have built and learned about software devleopment! '
	}}
>
	<section class="relative w-full">
		<div class="mx-auto max-w-2xl"></div>
		<section class="px-4 py-10">
			<div class="mx-auto max-w-2xl">
				<div>
					<h2 class="text-3xl font-bold">My Projects</h2>
					<p>Here are some projects that I am proud of:</p>
				</div>
				<div class="mt-5 space-y-10">
					{projects.map((project) => <ProjectCard project={project} />)}
				</div>
			</div>
		</section>
	</section>
</CoreLayout>
