---
import CoreLayout from '~/layouts/CoreLayout.astro'
import DarkMode from '~/components/DarkMode.astro'
import garminBryce from '~/imgs/garmin-bryce.jpeg'
import garminZion from '~/imgs/garmin-zion.jpeg'

const highlights = [
	'M.S. in Computer Science from <a href="https://omscs.gatech.edu/specialization-computing-systems" target="_blank" rel="noreferrer">Georgia Tech</a> with a specialization in Computing Systems. I graduated in May of 2026.'
]

const currentExperience = {
	role: 'Product Support Engineer',
	company: 'Tiny / TinyMCE',
	location: 'Remote',
	dates: 'Sep 2024 – Present',
	summary:
		'I help engineering teams successfully use TinyMCE by debugging integrations, reproducing issues, and translating customer problems into clear technical context.',
	bullets: [
		'Resolved over 3,700 tickets for a JavaScript-based rich text editor used by external engineering teams in high-traffic applications.',
		'Debugged customer implementations by analyzing JavaScript configuration, DOM behavior, network traces, and runtime errors.',
		'Reproduced reported issues as minimal test cases for the core engineering team.',
		'Nominated as the 2025 Most Valuable Team Member throughout the company.'
	]
}

const projects = [
	{
		name: 'icheatatwordle.com',
		tech: 'TypeScript',
		url: 'https://icheatatwordle.com',
		description:
			'A Wordle companion app that allows users to enter their guesses and see which remaining words are a possibility. Developed without any external dependencies.'
	},
	{
		name: 'MapReduce Data Processing Framework',
		tech: 'C++, gRPC',
		url: 'https://pdos.csail.mit.edu/6.824/papers/mapreduce.pdf',
		description:
			'Implemented a MapReduce-style data processing framework based on the original Google paper, demonstrating distributed systems fundamentals and RPC-based coordination.'
	},
	{
		name: 'Custom GETFILE Protocol',
		tech: 'C, Systems Programming',
		description:
			'Implemented a custom file transfer protocol over sockets, including multithreaded and shared-memory implementations.'
	},
	{
		name: 'eBay Clone Auction Platform',
		tech: 'Python, PostgreSQL',
		description:
			'Collaborated with teammates to build a multi-user auction platform with relational data modeling and marketplace-style user workflows.'
	}
]
---

<CoreLayout
	seo={{
		title: 'Clayton Schneider | Garmin',
		description:
			"Supplemental information about Clayton Schneider for Garmin's engineering team, including experience, projects, and education."
	}}
>
	<main class="relative mx-auto max-w-2xl px-4 pt-4">
		<div
			class="pointer-events-none absolute inset-x-0 top-0 -z-10 flex justify-center overflow-hidden"
		>
			<div class="h-96 w-96 rounded-full bg-slate-200/50 blur-3xl dark:bg-white/5"></div>
		</div>

		<nav class="mb-12 flex items-center justify-between">
			<a href="/" class="text-2xl font-bold hover:underline">Clayton Schneider</a>
			<DarkMode />
		</nav>

		<article
			class="prose prose-slate prose-a:font-bold prose-a:text-slate-700 prose-a:no-underline hover:prose-a:underline dark:prose-invert dark:prose-a:text-white mb-10 max-w-none"
		>
			<h1>Hello Garmin Engineering Team 👋</h1>

			<p>
				I’m a software engineer with a Master’s in Computer Science from Georgia Tech. I put this
				page together as supplemental information about me.
			</p>
			<section class="my-8">
				<figure>
					<div class="grid gap-2 sm:grid-cols-2">
						<img
							src={garminBryce.src}
							alt="Clayton at Bryce Canyon"
							class="aspect-[4/3] w-full object-cover shadow-md"
						/>
						<img
							src={garminZion.src}
							alt="Clayton at Zion National Park"
							class="aspect-[4/3] w-full object-cover shadow-md"
						/>
					</div>
					<figcaption class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
						Exploring Bryce Canyon and Zion National Park with my Garmin 930.
					</figcaption>
				</figure>
			</section>

			<h2>Some things I’m proud of</h2>
			<ul>
				{highlights.map((highlight) => <li set:html={highlight} />)}
				{
					projects.map((project) => (
						<li>
							<strong>
								{project.url ? (
									<a href={project.url} target="_blank" rel="noreferrer">
										{project.name}
									</a>
								) : (
									project.name
								)}
							</strong>{' '}
							<em>({project.tech})</em> — {project.description}
						</li>
					))
				}
			</ul>

			<h2>Currently</h2>
			<section class="not-prose">
				<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
					<h3 class="text-xl font-bold text-slate-900 dark:text-white">
						{currentExperience.role} — {currentExperience.company}
					</h3>
					<p class="text-sm text-slate-600 dark:text-slate-300">
						{currentExperience.dates} · {currentExperience.location}
					</p>
				</div>
				<p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-200">
					{currentExperience.summary}
				</p>
				<ul
					class="mt-3 list-disc space-y-1 pl-5 text-slate-700 marker:text-slate-300 dark:text-slate-200 dark:marker:text-slate-600"
				>
					{currentExperience.bullets.map((bullet) => <li>{bullet}</li>)}
				</ul>
			</section>
		</article>
	</main>
</CoreLayout>
